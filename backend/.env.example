# ============================================================
# EATWMS Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eatwms
DB_USER=eatwms_user
DB_PASSWORD=your_secure_db_password
TEST_DB_NAME=eatwms_test

# Production only (overrides individual DB vars)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-jwt-secret-must-be-at-least-32-chars-long
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-must-be-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Password
BCRYPT_ROUNDS=12

# Storage
# local | s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# S3 / MinIO (only needed when STORAGE_PROVIDER=s3)
S3_BUCKET=eatwms-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# App
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info
