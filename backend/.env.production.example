# ============================================================
# PRODUCTION Environment Variables — Render + Neon
# Add these in Render dashboard → Environment tab
# NEVER commit real values to Git
# ============================================================

# Server
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://your-app.onrender.com

# ── Neon Database ──────────────────────────────────────────
# Get this from: neon.tech → your project → Connection Details
DATABASE_URL=postgresql://eatwms_owner:[PASSWORD]@ep-xxxx.ap-south-1.aws.neon.tech/eatwms?sslmode=require

# ── JWT Secrets (generate with: openssl rand -hex 64) ─────
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=CHANGE_THIS_TO_ANOTHER_64_CHAR_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Storage ────────────────────────────────────────────────
# For Render: use local storage (uploaded to /tmp)
# OR use Cloudinary / AWS S3 for persistent storage
STORAGE_PROVIDER=local
UPLOAD_DIR=/tmp/uploads

# ── App Settings ───────────────────────────────────────────
BCRYPT_ROUNDS=12
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_FILE_SIZE_MB=5
LOG_LEVEL=warn

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# ── Redis (optional — Render Redis add-on) ─────────────────
# REDIS_URL=redis://red-xxxx.render.com:6379
