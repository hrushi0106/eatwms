# ============================================================
# EATWMS — Docker Environment Variables
# Copy to .env and fill in values before running docker-compose
# ============================================================

DB_NAME=eatwms
DB_USER=eatwms_user
DB_PASSWORD=your_secure_database_password_here

JWT_SECRET=your-jwt-secret-must-be-at-least-32-characters-long
REFRESH_TOKEN_SECRET=your-refresh-secret-must-be-at-least-32-characters-long

JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d
